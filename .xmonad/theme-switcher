#!/usr/bin/env nu
#
# * rofi - application launcher menu
# * xmobar - status bar
# * trayer - system tray
# * dunst - notifications
# * alacritty - terminal

use nu/dot/kv *
use std/log *

def wallpaper_dir [$style] {
  let base_dir = $"($env.HOME)/Pictures/wallpapers"
  $"($base_dir)/($style)"
}

def set_wallpaper [] {
  feh --bg-scale $in
}

def set_random_wallpaper [style] {
  ls (wallpaper_dir $style) | where type == file | shuffle | first | get name | set_wallpaper
}

def link_config [file_path, style] {
  let x = $"($env.HOME)/($file_path)"
  print $"($x).($style)" $x
  ln -f --symbolic --relative $"($x).($style)" $x
}

def set_rofi_theme [style] {
  $'@theme "($style)"' | save -f $"($env.HOME)/.config/rofi/adaptive_theme.rasi"
}

# trayer, xmobar, dunst
def expand_templates [style] {
  let themes_dir = $"($env.HOME)/.xmonad/themes/"
  let script = $"($env.HOME)/.xmonad/expand-template"
  let vars = $"($themes_dir)/vars/($style).nuon"

  nu $script --dir $themes_dir --vars-file $vars
}

def set_bunch_of_themes [style] {
  expand_templates $style
}

def set_alacritty_theme [style] {
  let x = $"($env.HOME)/.config/alacritty"
  let template = $'general.import = [ "solarized_($style).toml" ]'
  $template | save --force $"($x)/adaptive_theme.toml"
  touch $"($x)/alacritty.toml"
}

def set_theme [style --wallpaper-style:string] {
  set_bunch_of_themes $style
  set_alacritty_theme $style
  set_rofi_theme $style
  set_random_wallpaper ($wallpaper_style | default $style)
}

def system_theme [] {
  if (gsettings get org.gnome.desktop.interface color-scheme | str contains 'dark') {
    'dark'
  } else {
    'light'
  }
}

def restart_deamons [] {
  # restarted by xmobar dependency in systemd
  # systemctl --user restart trayer.service
  # systemctl --user restart xmobar.service

  xmonad --restart
  systemctl --user restart dunst.service
  notify-send 'Desktop theme update'
}

def "main monitor" [] {
  # Throttle updates so that all changes lead to xmonad restart but
  # not too frequently (give it 5sec to initialize)
  let restart_task = job spawn {
    mut last_restart = (date now) - 5sec
    mut next_restart = $last_restart
    loop {
      let $ts = job recv
      debug $"--- message ($ts) ---"
      if ($ts < $next_restart) { # delayed restart already scheduled
        debug "Throttling"
      } else if ($ts == $next_restart) { # delayed update
        $last_restart = date now
        restart_deamons
      } else if (($ts - $last_restart) > 5sec) {
        # either no scheduled restart or a race condition when timestamp from
        # monitor thread came earlier than throttling event
        $last_restart = date now
        restart_deamons
      } else {
        # setup throttling
        debug "Delay update"
        let x = ((date now) + 5sec)
        $next_restart = $x
        let parent_task = job id
        job spawn {
          sleep 5sec
          debug $">>> sending ($x)"
          $x | job send ($parent_task)
        }
      }
    }
  }
  gsettings monitor org.gnome.desktop.interface color-scheme
      | lines
      | each {|line|
          system_theme | set_theme $in
          date now | job send $restart_task
      }
}

def split_ext_style [] {
   parse --regex "\(\(?<ext>.*\)-\)?\(?<style>.*\)" | first
}

def set_theme_ext [$ext_style --persist] {
  let r = $ext_style | split_ext_style
  let new_style = $r.style
  let ext = $r.ext

  let gnome_style = if ($new_style == light) {
      'prefer-light'
    } else if ($new_style == dark) {
      'prefer-dark'
    } else {
      print "expecting 'light' or 'dark'"
      exit 1
    }
  set_theme $new_style --wallpaper-style $ext

  info $"persist: ($persist)"
  info $"new_style: ($new_style)"
  if ($persist) {
    $ext_style | store_key "theme-style"
    gsettings set org.gnome.desktop.interface color-scheme $gnome_style
    date now | store_key "theme-style-last-set-time"
  }
}

def "main expand-templates" [new_style] {
  set_theme_ext $new_style
}

def "main set" [new_style] {
  set_theme_ext $new_style --persist
}

def "main set-by-time" [] {
  let h = date now | format date "%H" | into int
  let ext_style = if (6 <= $h and $h < 9) {
    "early-light"
  } else if (9 <= $h and $h < 18) {
    "light"
  } else if (18 <= $h and $h < 10) {
    "dark"
  } else {
     "late-dark"
  }
  set_theme_ext $ext_style --persist
}

def "main toggle" [] {
  let style = if ((system_theme) =~ "light") { "dark" } else { "light" }
  set_theme_ext $style --persist
}

def open_menu [] {
  (/usr/bin/rofi
    -dmenu
    -window-title "Wallpapers"
    -cycle
    -selected-row
    -auto-select
  )
}

def "main choose-wallpaper" [] {
  "theme-style" | load_key | print $in
  let $r = "theme-style" | load_key | default (system_theme) | split_ext_style
  let $dir = wallpaper_dir ($r.ext | default $r.style)
  print $r
  info $dir
  cd $dir
  $env.YAZI_WALLPAPER_EXPLORER = true
  (alacritty
    -o window.dimensions.columns=100 -o window.dimensions.lines=30
    --class xmonad-center-float -e yazi
  )
}

def main [] {
  system_theme
}
