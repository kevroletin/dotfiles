def yes_no [$msg $act] {
  "yes\nno" | rofi -theme-str 'entry { placeholder: "yes"; }' -l 2 -dmenu -p $msg | each {
    if ($in =~ "yes") {
      do $act
    }
  }
}

def screenshot [--fullscreen] {
  let dir = $"($env.HOME)/Share/screenshots"
  mkdir $dir
  cd $dir
  let opts = if $fullscreen { [] } else { [--select] }
  let fname = scrot ...$opts --freeze -e 'echo "$f"' | str trim
  $"($dir)/($fname)" | xclip -i -selection clipboard
  notify-send $"Screenshot: ($fname)"
}

# open pamix and switch it into "output" tab
def pamix [] {
  let idx = job spawn {
    alacritty_float pamix --w=80 --h=20
    "done" | job send 0
  }
  # wait until pamix started and ready to handle input
  let win_id = do {
    mut pid = 0
    loop {
      sleep 100ms
      let pids = job list | where id == $idx | get pids | first
      if ($pids | is-not-empty) {
        $pid = ($pids | first | into int)
        break
      }
    }
    sleep 100ms
    xdotool search --pid $pid | into int
  }
  xdotool key --window $win_id F3
  job recv
}

def quick_yazi_float [$dir] {
  with-env { YAZI_QUIT_AFTER_OPEN: true } {
    yazi_float $dir
  }
}

def window_list [--bring] {
  let curr_ws = xdotool get_desktop | str trim
  let ws_list = wmctrl -l | parse --regex '^([^\s]+)\s+([^\s]+)\s+([^\s]+)\s+(.*)$' | str trim | rename id ws host name
  let our_ws = $ws_list
    | insert class { |row| xprop -id $row.id WM_CLASS | parse --regex '"([^"]+)"' | first | values | first }
    | update id { into int }
  let our_ws = if $bring {
    $our_ws
  } else {
    $our_ws
    | where ws == $curr_ws
  }

  let stacking = xprop -root | parse "_NET_CLIENT_LIST_STACKING(WINDOW): window id # {res}" | get res | first | split row ", "

  let win_order = $stacking | enumerate | each {
    { ($in.item | into int): ($in.index) }
  } | into record

  let $sorted = $our_ws
    | insert order { |row| ($win_order | get --optional ($row.id | into string)) | default 0 }
    | insert ws_1 { |row| ($row.ws | into int | ($in + 1)) }
    | sort-by --reverse order

  if ($sorted | is-not-empty) {
    let choise = $sorted
      | select ws_1 class name
      | table --theme none -i false --width 1000 | lines | skip 1 | to text | ansi strip
      | rofi -dmenu -i -format i

    let res = $sorted | get ($choise | into int)

    if $bring {
      wmctrl -i -r $res.id -t $curr_ws
    }
    wmctrl -i -a $res.id
  }
}

