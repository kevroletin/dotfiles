#!/usr/bin/env nu

~/bin/screen-recording-stop

mkdir $"($env.HOME)/Videos/recordings"
cd $"($env.HOME)/Videos/recordings"

let filename = $"capture_(date now | format date "%Y.%m.%d-%H:%M:%S").mp4"

let audio_sources = (
  (pactl list sinks | parse "{_}Name:{name}" | get name | str trim | each { $"i\t($in)" } ) | append
  (pactl list sources | parse "{_}Name:{name}" | get name | str trim | each { $"o\t($in)" } )
)

let res = $audio_sources | to text | rofi -dmenu -p "Audio source" -i | parse "{_}\t{res}" | get res

if ($res | is-empty) {
  exit 1
}

let params = [
  ffmpeg
  -loglevel debug
  -threads:v 2
  -threads:a 8
  -filter_threads 2
  -thread_queue_size 512
  -video_size 1920x1080
  -framerate 25
  -f x11grab
  -i $env.DISPLAY
  -thread_queue_size 512
  -f pulse
  -ac 2
  -i $"'($res)'"
  -bsf:a aac_adtstoasc
  -c:a aac
  -ac 2
  -b:a 128k
  -b:v 2400k
  -minrate:v 2400k
  -maxrate:v 2400k
  -bufsize:v 2400k
  -c:v h264_nvenc -qp:v 19
  $"'($filename)'"
]

let cmd = $params | str join " "
let script = $"#!/bin/sh

nohup ($cmd) &
echo $! > /tmp/screen_capture_pid
notify-send 'Screen recording started'
"

$script | sh -

