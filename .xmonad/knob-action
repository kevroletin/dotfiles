#!/usr/bin/env nu

use nu/dot/kv *
use nu/dot/sys *
use nu/dot/theme *
use std/assert *

def act_volume [act] {
  match ($act) {
    "+" => (^pactl set-sink-volume @DEFAULT_SINK@ +3%),
    "-" => (^pactl set-sink-volume @DEFAULT_SINK@ -3%)
    "!" => (^pactl set-sink-volume @DEFAULT_SINK@ 0)
  }
  date now | save -f  ~/.local/share/dotfiles/volume-indicator-wakeup
}

def act_opacity [act] {
  match ($act) {
    "+" => (more-opacity),
    "-" => (less-opacity),
  }
}

def act_window_opacity [act] {
  match ($act) {
    "+" => (picom-trans -c "+4"),
    "-" => (picom-trans -c "-2"),
  }
}

def act_window_size [act] {
  match ($act) {
    "+" => (xmonadctl "window-expand"),
    "-" => (xmonadctl "window-shrink"),
  }
}

def act_window_width [act] {
  match ($act) {
    "+" => (xmonadctl "window-expand-horiz"),
    "-" => (xmonadctl "window-shrink-horiz"),
  }
}
def act_window_height [act] {
  match ($act) {
    "+" => (xmonadctl "window-expand-vert"),
    "-" => (xmonadctl "window-shrink-vert"),
  }
}

def act_gaps [act new_value?] {
  # + makes windows "bigger"
  match ($act) {
    "-" => (^xmonadctl layout-spacing-inc),
    "+" => (^xmonadctl layout-spacing-dec),
  }
}

def act_brightness [act new_value?] {
  match ($act) {
    "+" => (nu "~/bin/adjust-brightness" +),
    "-" => (nu "~/bin/adjust-brightness" -),
    "!" => (theme-switcher toggle),
  }
}

def check_mode [mode] {
  assert ($mode in ["brightness" "volume" "gaps" "opacity" "window-opacity" "window-width" "window-height" "window-size"])
}

def store_mode [mode] {
  check_mode $mode

  { "knob-action-last-set-time": (date now)
  , "knob-action": $mode
  } | store_keys
}

def "main set-mode" [mode] {
  store_mode $mode
  notify-send $"Knob mode: ($mode)"
}

def "main get-mode" [] {
  ["knob-action-last-set-time" "knob-action"] | load_keys
}

def main [act] {
  let res = ["knob-action-last-set-time" "knob-action"] | load_keys
  let $last_time = $res.knob-action-last-set-time
  let $last_action = $res.knob-action

  let bad_input = ($last_time | is-empty) or ($last_action | is-empty)
  let action = if ($bad_input or ((date now) - $last_time > 60sec)) {
    "brightness"
  } else {
    $last_action
  }

  match $action {
    "brightness" => (act_brightness $act),
    "gaps" => (act_gaps $act),
    "volume" => (act_volume $act),
    "opacity" => (act_opacity $act),
    "window-opacity" => (act_window_opacity $act),
    "window-width" => (act_window_width $act),
    "window-height" => (act_window_height $act),
    "window-size" => (act_window_size $act),
  }

  store_mode $action
}

