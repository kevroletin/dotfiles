Config {
  -- font = "xft:UbuntuMono Nerd Font Mono:style=Bold 12"
  -- font = "xft:SauceCodePro Nerd Font"
  -- font = "xft:UbuntuMono Nerd Font 14"
  -- font = "xft:Hack Nerd Font"
  -- font = "xft:CodeNewRoman Nerd Font"
  font = "xft:Bitstromwera Nerd Font"
  -- font = "xft:Monofur Nerd Font"
  -- font = "xft:BlexMono Nerd Font"
  , textOffset = 0

  , bgColor = "($xmobar.background)"
  , fgColor = "($xmobar.foreground)"

  -- Part of ordering trayer on top of xmobar
  -- https://xmonad.github.io/xmonad-docs/xmonad-contrib/XMonad-Util-Hacks.html#g:3
  , lowerOnStart = True
  , overrideRedirect = True

  , position = TopSize L 100 23
  , commands = [
        Run MultiCpu [
            "-w", "2"
          , "-L", "2"
          , "-H", "50"
          , "--normal", "#112c36"
          , "--high", "#cc9290"
          , "--template", "<total>"
          ]
          10
      , Run Memory ["-w", "2", "-t","<usedratio>"] 10
      , Run Battery [
            "--template" , "<acstatus>"
          , "--Low"      , "20"               -- units: %
          , "--High"     , "80"               -- units: %
          , "--low"      , "($xmobar.widget-white)"
          , "--normal"   , "($xmobar.widget-yellow)"
          , "--high"     , "($xmobar.widget-red)"

          , "--" -- battery specific options
                                              -- discharging status
          , "-o"	, "🏃‍➡️<left>%"
                                              -- AC "on" status
          , "-O"	, "🗲<left>%"               -- ⌁
                                              -- charged status
          , "-i"	, "<fc=($xmobar.green)>100%</fc>"
          ]
          50
        , Run Swap ["-w", "2", "-t","<usedratio>"] 10
        , Run Date "%a %b%_d" "date" 10
        , Run XMonadLog
      ]
  , sepChar = "%"
  , alignSep = "}{"
  , template = " %XMonadLog%}{|  %battery%  %multicpu% 󱊟 %memory%%swap% <fc=($xmobar.green)>%date%</fc> |          "
  , allDesktops = True
}
